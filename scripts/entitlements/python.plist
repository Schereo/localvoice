<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for executables in the embedded Python runtime (Contents/Resources/runtime). -->
<plist version="1.0">
<dict>
	<!-- ctypes and PyObjC build libffi closures in writable, executable memory. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Extension modules come from third-party wheels; don't tie loading them to one signing team. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- The ctrlspeak service records from the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Media pause sends Apple Events through osascript. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
